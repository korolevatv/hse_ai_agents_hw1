{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "yandex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Yandex AI Studio",
      "options": {
        "baseURL": "https://ai.api.cloud.yandex.net/v1",
        "apiKey": "{env:YANDEX_API_KEY}",
        "headers": {
          "Authorization": "Api-Key {env:YANDEX_API_KEY}",
          "OpenAI-Project": "b1gv4m4vdn58mat55ggl"
        }
      },
      "models": {
        "aliceai-llm-flash": {
          "name": "Alice AI LLM Flash",
          "id": "gpt://b1gv4m4vdn58mat55ggl/aliceai-llm-flash",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "allow"
  }
}